# Standard workstation mode: keep application and maintenance data on the SSD.
GRAND_LINE_DATABASE_MODE="local"
LOCAL_DB_PATH="/Volumes/OWC Express 1M2 80G/grand-line-data/grand-line.db"

# Mock cards are fail-closed by default. Enable only for explicit UI review.
GRAND_LINE_ALLOW_MOCK_DATA="0"

# Optional explicit image cache override. By default it is placed beside the DB.
# IMAGE_CACHE_DIR="/Volumes/OWC Express 1M2 80G/grand-line-data/image-cache"
